{
  "manifest_version": 3,
  "name": "EyeD Demo - Eye Tracking Heatmap (Local Only)",
  "version": "1.3.1",
  "version_name": "1.3.0 Demo",
  "description": "Demo version of EyeD eye tracking extension. All data stays local — no server connection, no API key required. Track gaze via webcam, generate heatmaps, scanpaths, and behavioral analytics locally in your browser.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/analytics.js",
        "content/video-tracker.js",
        "content/screenshot.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle recording on/off"
    },
    "toggle-heatmap": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Toggle heatmap overlay"
    },
    "take-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture viewport screenshot"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' https://cdn.jsdelivr.net/npm/@tensorflow/ https://cdn.jsdelivr.net/npm/@mediapipe/; style-src 'self'; img-src 'self' data:; connect-src https:; font-src 'self'; object-src 'none'; form-action 'self'; base-uri 'self'; upgrade-insecure-requests"
  }
}
